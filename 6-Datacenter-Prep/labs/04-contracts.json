 "tasks": [
  {
   "title": "Filter",
   "text": "Unter **Contracts > Filters** einen Filter **tcp-8080** mit einem Entry: EtherType IP, Protocol tcp, Destination Port 8080.",
   "hint": "Für Ping gibt es im Tenant common schon den Filter **icmp** – den kannst du direkt verwenden."
  },
  {
   "title": "Contract",
   "text": "Contract **web-to-app** (Scope VRF) mit einem Subject, das die Filter tcp-8080 und icmp enthält."
  },
  {
   "title": "Provider und Consumer",
   "text": "Die EPG **App** stellt den Dienst bereit (**Provided**), die EPG **Web** nutzt ihn (**Consumed**). Am EPG unter **Contracts** hinzufügen."
  },
  {
   "title": "Testen",
   "text": "web1 → app1: TCP 8080 und ICMP klappen, TCP 22 nicht. app1 → web1 auf TCP 8080 ist blockiert. Auf leaf101: `show zoning-rule` – erkennst du die Regeln bi-dir und uni-dir-ignore?"
  },
  {
   "title": "vzAny",
   "text": "Filter **ssh** (tcp/22) und Contract **mgmt-ssh** anlegen. Unter **VRF Prod > EPG Collection for VRF** den Contract als **Provided** eintragen, an der EPG **Mgmt** als **Consumed**.",
   "hint": "vzAny steht für alle EPGs im VRF. Weil nur Mgmt konsumiert, darf Web trotzdem nicht per SSH zu App."
  }
 ],
 "checks": [
  {
   "desc": "web1 → app1 TCP 8080 erlaubt",
   "type": "traffic",
