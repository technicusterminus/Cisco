  },
  {
   "desc": "pc2 hat ein DHCP-Lease",
   "type": "dhcp",
   "host": "pc2"
  },
  {
   "desc": "pc1 erreicht dhcp1",
   "type": "traffic",
   "src": "pc1",
   "dst": "dhcp1",
   "expect": true
  },
  {
   "desc": "Least Privilege Clients → Services: nur Ping (und DHCP)",
   "type": "exposure",
   "src": "pc1",
   "dst": "dhcp1",
   "allow": [
    "icmp"
   ],
   "category": "security"
  }
 ],
 "questions": [
  {
   "id": "q1",
   "q": "Warum bekommt pc1 ohne Relay keine Adresse, obwohl ein Contract alles erlaubt?",
   "options": [
    "Der Discover ist ein Broadcast im BD-Clients; der Server steht in einem anderen BD",
    "Weil UDP fehlt",
    "Weil der Server aus ist",
    "Weil der Contract falsch herum ist"
   ],
   "answer": 0,
   "explain": "Contracts regeln Unicast zwischen EPGs; den Broadcast bringt erst der Relay zum Server."
  }
 ],
