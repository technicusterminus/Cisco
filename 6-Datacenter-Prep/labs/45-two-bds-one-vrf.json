 "questions": [
  {
   "id": "q1",
   "q": "Wer routet zwischen BD-Web und BD-App, wenn beide in der VRF Prod liegen?",
   "options": [
    "Jeder Leaf mit der VRF selbst (Pervasive Gateway, Anycast)",
    "Ein externer Router über einen L3Out",
    "Die Spines",
    "Der APIC"
   ],
   "answer": 0,
   "explain": "Das BD-Subnetz ist auf allen Leafs mit der BD dasselbe Gateway; geroutet wird am Ingress-Leaf."
  },
  {
   "id": "q2",
   "q": "Warum ist nach der Korrektur trotzdem ein Contract nötig?",
   "options": [
    "Die VRF ist enforced: Zwischen zwei EPGs gilt Implicit Deny, egal ob geroutet oder gebridged",
    "Wegen des Routings",
    "Ist er nicht",
    "Wegen der VLANs"
   ],
   "answer": 0,
   "explain": "Routing und Policy sind getrennte Schritte. Routing macht das Ziel erreichbar, der Contract erlaubt den Fluss."
  }
