 "tasks": [
  {
   "title": "Management-Adressen",
   "text": "**Tenant mgmt > Node Management Addresses**: Static Node Management Addresses für 101–104, 201, 202 (192.168.10.<Node-ID>/24, Gateway 192.168.10.254)."
  },
  {
   "title": "SNMP-Polling",
   "text": "**Fabric > Fabric Policies > Policies > Pod > SNMP**: Policy **default** aktivieren, Contact und Location, Community **NMS-Read**, Client Group mit Management EPG default (Out-of-Band) und Client **192.168.10.61**. Dann eine Pod Policy Group **PodPol** mit dieser SNMP Policy und im Pod Profile default zuweisen.",
   "hint": "Ohne Client Group beantwortet die ACI keine SNMP-Anfrage – auch mit richtiger Community nicht."
  },
  {
   "title": "Destination Groups",
   "text": "**Admin > External Data Collectors > Monitoring Destinations**: Syslog-Gruppe **Syslog** (Ziel 192.168.10.60, Severity information), SNMP-Gruppe **NMS-Traps** (192.168.10.61:162, v2c, NMS-Read), Callhome-Gruppe **NOC-Mail** (From apic1@firma.de, SMTP 192.168.10.62, Ziel noc@firma.de). Jeweils Management EPG default (Out-of-Band)."
  },
  {
   "title": "Sources",
   "text": "**Fabric Policies > Policies > Monitoring > Common Policy**: Syslog Source (Faults und Audit, ab warning), SNMP Source (Faults ab minor), Callhome Source (Faults ab major) – jeweils mit ihrer Destination Group.",
   "hint": "Ohne Source sendet der APIC nichts, auch wenn die Destination Group fertig ist."
  },
  {
   "title": "Testen",
   "text": "Simulation > Fileserver & Monitoring: *snmpwalk* gegen apic1 und leaf101, dann einen Test-Fault **major** auslösen. Er muss beim Syslog-Server, beim SNMP-Manager und als Mail ankommen."
  }
 ],
