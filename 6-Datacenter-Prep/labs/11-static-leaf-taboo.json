 "tasks": [
  {
   "title": "Static Leaf",
   "text": "In der EPG **App** unter **Static Leafs**: Node **102**, Encap **vlan-120**, Mode Trunk.",
   "hint": "Ein Static Leaf deployt die EPG auf allen Ports des Leafs, deren Access Policy die Domain der EPG enthält."
  },
  {
   "title": "Prüfen",
   "text": "app2 ist jetzt in der EPG App gelernt. Auf leaf102: `show vlan extended` – auf welchen Ports liegt vlan-120?"
  },
  {
   "title": "Taboo Contract",
   "text": "Unter **Contracts > Taboos** den Taboo Contract **no-ping** mit einem Subject und dem Filter **icmp** (aus common) anlegen. An der EPG **App** unter **Contracts** als **Taboo Contract** hinzufügen."
  },
  {
   "title": "Testen",
   "text": "Ping web1 → app1 ist blockiert, TCP 8080 funktioniert weiter."
  }
 ],
 "checks": [
  {
   "desc": "app2 gelernt in EPG App",
   "type": "endpoint",
   "host": "app2",
   "epg": "uni/tn-Shop/ap-Webshop/epg-App"
  },
  {
   "desc": "web1 → app2 TCP 8080 erlaubt",
   "type": "traffic",
   "src": "web1",
   "dst": "app2",
   "proto": "tcp",
   "port": 8080,
   "expect": true
  },
  {
   "desc": "web1 → app1 Ping blockiert (Taboo)",
   "type": "traffic",
   "src": "web1",
   "dst": "app1",
   "proto": "icmp",
   "expect": false
  },
  {
   "desc": "web1 → app1 TCP 8080 weiter erlaubt",
   "type": "traffic",
   "src": "web1",
   "dst": "app1",
   "proto": "tcp",
   "port": 8080,
   "expect": true
  }
 ],
 "solution": "Static Leaf: `fvRsNodeAtt tDn=topology/pod-1/node-102 encap=vlan-120` an der EPG App. Taboo: `vzTaboo no-ping` mit `vzTSubj` und `vzRsDenyRule tnVzFilterName=icmp`, an der EPG `fvRsProtBy tnVzTabooName=no-ping`.",
 "routers": [],
 "vcenters": [],
 "solutionConfig": [
  [
   "uni/tn-Shop",
   {
    "fvTenant": {
     "attributes": {},
     "children": [
