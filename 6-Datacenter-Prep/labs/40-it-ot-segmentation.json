 "questions": [
  {
   "id": "q1",
   "q": "Warum bekommen Monitoring und Administration getrennte Contracts?",
   "options": [
    "Weil ACI nur einen Filter pro Contract erlaubt",
    "Damit ein kompromittiertes Monitoring keine Administrationsrechte hat (SNMP lesen ≠ SSH)",
    "Wegen der Performance",
    "Das ist egal"
   ],
   "answer": 1,
   "explain": "Trennung nach Zweck: Wer nur beobachten muss, bekommt keine Werkzeuge zum Ändern."
  },
  {
   "id": "q2",
   "q": "Warum Intra EPG Isolation für die Zone PLC?",
   "options": [
    "Damit eine kompromittierte Steuerung die andere nicht erreicht (laterale Bewegung)",
    "Damit Modbus schneller ist",
    "Weil sonst SCADA die Steuerungen nicht erreicht",
    "Weil Steuerungen kein IP sprechen"
   ],
   "answer": 0,
   "explain": "Zwischen Zonen schützen Contracts, innerhalb der Zone braucht es eine eigene Maßnahme."
  },
  {
   "id": "q3",
   "q": "Ein Kollege verbindet alle Zonen mit einem Contract „permit any“. Was stimmt?",
   "options": [
    "Alle Funktionstests sind grün, die Least-Privilege-Prüfungen scheitern",
    "Nichts funktioniert mehr",
    "Das ist Least Privilege, weil alles geht",
    "ACI lehnt so einen Contract ab"
   ],
   "answer": 0,
   "explain": "„Alles funktioniert“ ist nicht dasselbe wie „nur das Nötige ist erlaubt“."
  }
