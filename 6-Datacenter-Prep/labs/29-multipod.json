 "tasks": [
  {
   "title": "Infra-L3Out",
   "text": "Im Tenant **infra** ein L3Out **multipod** (VRF overlay-1, OSPF Area 0, BGP) mit allen vier Spines und ihren Sub-Interfaces anlegen – am schnellsten über **Fabric > Inventory > Quick Start > Add Pod**. Unter Simulation > IPN & WAN wird ipn1 FULL."
  },
  {
   "title": "Pod TEP Pool",
   "text": "**Pod Fabric Setup Policy**: Pod 2 mit 10.1.0.0/16 (macht der Add-Pod-Wizard mit)."
  },
  {
   "title": "DHCP Relay im IPN",
   "text": "Simulation > IPN & WAN: auf **ipn1 und ipn2** das DHCP Relay auf die TEP-Adresse des APIC setzen. Danach erscheinen spine203/204 unter *Nodes Pending Registration*.",
   "hint": "Ohne Relay kommt der DHCP Discover der Pod-2-Spines nie beim APIC an."
  },
  {
   "title": "Registrieren",
   "text": "spine203 (203), spine204 (204), leaf105 (105), leaf106 (106) – jeweils **Pod ID 2**."
  },
  {
   "title": "IPN-Fehler finden",
   "text": "Die Pod-2-Spines kommen nicht auf FULL. `show ip ospf neighbors vrf overlay-1` auf spine203 und die Simulation zeigen warum. Auf ipn2 die richtige MTU (9150) setzen.",
   "hint": "Erst danach sind leaf105/106 vom APIC aus erreichbar."
  },
  {
   "title": "Data Plane TEP",
   "text": "Fabric External Connection Policy (Tenant infra) mit Pod Connection Profiles für Pod 1 und 2 prüfen."
  },
  {
   "title": "Verkehr",
   "text": "Traffic-Test web1 (Pod 1) → app1 (Pod 2) tcp/8080."
  }
 ],
