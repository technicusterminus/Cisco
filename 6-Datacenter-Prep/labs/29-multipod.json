nstT\": \"sub-interface\", \"encap\": \"vlan-4\", \"addr\": \"192.168.2.5/30\"}}}]}}]}}]}}]}}` und `{\"fvTenant\": {\"attributes\": {\"name\": \"infra\"}, \"children\": [{\"fabricExtConnP\": {\"attributes\": {\"id\": \"1\", \"name\": \"Multipod\"}, \"children\": [{\"fabricPeeringP\": {\"attributes\": {\"type\": \"automatic_with_full_mesh\"}}}, {\"fabricPodConnP\": {\"attributes\": {\"id\": \"1\"}, \"children\": [{\"fabricIp\": {\"attributes\": {\"addr\": \"172.16.1.1/32\"}}}]}}, {\"fabricPodConnP\": {\"attributes\": {\"id\": \"2\"}, \"children\": [{\"fabricIp\": {\"attributes\": {\"addr\": \"172.16.2.1/32\"}}}]}}]}}]}}`, `uni/controller/setuppol` mit `fabricSetupP podId=2 tepPool=10.1.0.0/16`. Im IPN: Relay 10.0.0.1 auf ipn1/ipn2, MTU von ipn2 auf 9150. Registrierung mit podId=2.",
