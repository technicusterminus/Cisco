 "questions": [
  {
   "id": "q1",
   "q": "Was gilt für eine EPG, die nicht Mitglied der Preferred Group ist?",
   "options": [
    "Sie braucht weiterhin Contracts – zu Mitgliedern wie zu anderen",
    "Sie darf alles",
    "Sie wird isoliert, auch intern",
    "Sie verliert ihre Endpoints"
   ],
   "answer": 0,
   "explain": "Die Preferred Group öffnet nur zwischen Mitgliedern."
  },
  {
   "id": "q2",
   "q": "Warum ist die Preferred Group nur eine Übergangslösung?",
   "options": [
    "Sie ist langsam",
    "Zwischen den Mitgliedern gilt kein Least Privilege mehr – das widerspricht dem Whitelist-Modell",
    "Sie funktioniert nur 30 Tage",
    "Sie kostet Lizenzen"
   ],
   "answer": 1,
   "explain": "Sie ist praktisch für Migrationen. Danach sollten die benötigten Flüsse als Contracts gebaut werden."
  }
 ],
 "solution": "`POST /api/mo/uni/tn-Shop.json` mit `{\"fvTenant\": {\"attributes\": {}, \"children\": [{\"fvCtx\": {\"attributes\": {\"name\": \"Prod\"}, \"children\": [{\"vzAny\": {\"attributes\": {\"prefGrMemb\": \"enabled\"}}}]}}, {\"fvAp\": {\"attributes\": {\"name\": \"Webshop\"}, \"children\": [{\"fvAEPg\": {\"attributes\": {\"name\": \"Web\", \"prefGrMemb\": \"include\"}}}, {\"fvAEPg\": {\"attributes\": {\"name\": \"App\", \"prefGrMemb\": \"include\"}}}]}}]}}`",
