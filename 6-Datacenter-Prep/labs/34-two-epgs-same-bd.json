 "questions": [
  {
   "id": "q1",
   "q": "adm1 und web1 sind im selben Subnetz. Warum scheitert der Ping im Ausgangszustand?",
   "options": [
    "ARP wird nicht beantwortet",
    "Die EPGs Admin und Web brauchen einen Contract, auch in derselben BD",
    "Das Gateway fehlt",
    "VLAN 111 ist nicht im Pool"
   ],
   "answer": 1,
   "explain": "Bridging (Layer 2) funktioniert, die Policy-Entscheidung kommt danach."
  },
  {
   "id": "q2",
   "q": "Warum kann web1 nach der Lösung auch adm1 pingen?",
   "options": [
    "Weil Web auch Consumer ist",
    "Weil die ICMP-Regel in der Gegenrichtung (ohne Ports) genauso passt",
    "Weil ICMP in ACI nie gefiltert wird",
    "Weil beide in derselben BD sind"
   ],
   "answer": 1,
   "explain": "Das Subject erlaubt Provider → Consumer für denselben Filter. ICMP hat keine Ports, also passt auch ein Echo Request."
  }
 ],
 "solution": "`POST /api/mo/uni.json` mit `{\"fvTenant\": {\"attributes\": {\"name\": \"Shop\"}, \"children\": [{\"vzFilter\": {\"attributes\": {\"name\": \"ssh\"}, \"children\": [{\"vzEntry\": {\"attributes\": {\"name\": \"ssh\", \"etherT\": \"ip\", \"prot\": \"tcp\", \"dFromPort\": \"22\", \"dToPort\": \"22\"}}}]}}, {\"vzBrCP\": {\"attributes\": {\"name\": \"admin-to-web\", \"scope\": \"context\"}, \"children\": [{\"vzSubj\": {\"attributes\": {\"name\": \"subj\", \"revFltPorts\": \"yes\"}, \"children\": [{\"vzRsSubjFiltAtt\": {\"attributes\": {\"tnVzFilterName\": \"ssh\"}}}, {\"vzRsSubjFiltAtt\": {\"attributes\": {\"tnVzFilterName\": \"icmp\"}}}]}}]}}, {\"fvAp\": {\"attributes\": {\"name\": \"Webshop\"}, \"children\": [{\"fvAEPg\": {\"attributes\": {\"name\": \"Admin\"}, \"children\": [{\"fvRsCons\": {\"attributes\": {\"tnVzBrCPName\": \"admin-to-web\"}}}]}}, {\"fvAEPg\": {\"attributes\": {\"name\": \"Web\"}, \"children\": [{\"fvRsProv\": {\"attributes\": {\"tnVzBrCPName\": \"admin-to-web\"}}}]}}]}}]}}`",
