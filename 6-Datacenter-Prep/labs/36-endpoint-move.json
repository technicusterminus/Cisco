   "id": "q1",
   "q": "Warum wurde app2 nach dem Umbau nicht mehr gelernt, obwohl VLAN und IP gleich blieben?",
   "options": [
    "Der neue Port hat keine Bindung an die EPG App",
    "app2 brauchte eine neue IP",
    "Der Contract galt nur für den alten Port",
    "Endpoints werden nur einmal pro Tag gelernt"
   ],
   "answer": 0,
   "explain": "Die EPG-Zuordnung hängt an Port und VLAN. Ein neuer Port braucht eine eigene Bindung."
  },
  {
   "id": "q2",
   "q": "Warum ist die alte Bindung gefährlich?",
   "options": [
    "Sie verbraucht zu viel TCAM",
    "Jedes Gerät, das dort mit VLAN 120 sendet, landet in der EPG App und erbt ihre Freigaben",
    "Sie verhindert das Lernen am neuen Port",
    "Sie ist nicht gefährlich"
   ],
   "answer": 1,
   "explain": "Genau das ist pc-x passiert: Das Notebook ist in der EPG App gelandet und könnte deren Contracts nutzen."
  }
 ],
