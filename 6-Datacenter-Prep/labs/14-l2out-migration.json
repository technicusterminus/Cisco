 "tasks": [
  {
   "title": "Access Policies",
   "text": "VLAN Pool **VLAN-Pool-Legacy** (static, vlan-300), **External Bridged Domain** **L2Dom-Legacy** (Physical and External Domains > External Bridged Domains), AAEP **AAEP-Legacy**, Policy Group **IPG-Legacy**, Interface Profile **IntProf-Leaf103** mit Port 1/20 und Switch Profile **SwProf-Leaf103** für Node 103."
  },
  {
   "title": "L2Out",
   "text": "Im Tenant Shop **Networking > L2Outs**, **Create L2Out**: Name **Legacy**, Bridge Domain **BD-Migration**, Encap **vlan-300**, Domain L2Dom-Legacy, Path leaf103 eth1/20, External EPG **LegacyNet**."
  },
  {
   "title": "Contract",
   "text": "Contract **migration** (Filter **default** aus common): LegacyNet *Provided*, EPG **Neu** *Consumed*.",
   "hint": "Ein L2Out hat ein eigenes External EPG (eigener pcTag) – auch im selben BD braucht es einen Contract."
  },
  {
   "title": "Erster Test",
   "text": "Ping von web2 zu old-srv. Warum scheitert er? Lies den Schritt im Ergebnis."
  },
  {
   "title": "ARP Flooding",
   "text": "Im **BD-Migration** unter Policy > General **ARP Flooding** aktivieren und erneut testen.",
   "hint": "Ohne Unicast Routing kann die ACI kein ARP Glean machen. Den ARP-Request für einen unbekannten Host muss sie dann fluten."
  }
 ],
