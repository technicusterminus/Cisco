 "questions": [
  {
   "id": "q1",
   "q": "Warum scheitert der Ping, obwohl das L2Out steht?",
   "options": [
    "old-srv ist still und ohne Unicast Routing gibt es kein ARP Glean – ohne ARP Flooding erreicht ihn die Anfrage nicht",
    "Weil der Contract fehlt",
    "Weil das VLAN falsch ist",
    "Weil L2Outs kein ICMP können"
   ],
   "answer": 0,
   "explain": "Mit Unicast Routing und BD-Subnetz könnte die ACI per Glean suchen; in der Migrationsphase gibt es beides nicht."
  },
  {
   "id": "q2",
   "q": "Warum braucht es einen Contract, obwohl alles in derselben BD liegt?",
   "options": [
    "Das External EPG des L2Outs ist eine eigene Sicherheitszone mit eigenem pcTag",
    "Braucht es nicht",
    "Wegen des VLANs",
    "Weil L2Outs immer geroutet werden"
   ],
   "answer": 0,
   "explain": "Wie bei zwei EPGs im selben BD (Lab 34): Bridging ist nicht Policy."
  }
 ],
