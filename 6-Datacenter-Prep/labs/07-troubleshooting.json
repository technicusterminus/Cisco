 "tasks": [
  {
   "title": "Ticket 1",
   "text": "„Mein PC (pc1) bekommt keine Verbindung.\"\n\n**Finden mit:** Tab *Faults* der EPG **Clients** (oder `moquery -c faultInst -f 'fault.Inst.code==\"F0467\"'` auf dem APIC).",
   "hint": "Lies den Grund im F0467 genau: Welches VLAN, welcher Pool?"
  },
  {
   "title": "Ticket 2",
   "text": "„Der Fileserver files1 an leaf102 Port 12 ist nicht erreichbar.\"\n\n**Finden mit:** Tab *Faults* der EPG **Files**, danach die Access Port Selectors unter *Fabric > Access Policies*.",
   "hint": "invalid-path heißt: Für diesen Port gibt es keine Access Policy mit der Domain."
  },
  {
   "title": "Ticket 3",
   "text": "„web1 erreicht app1 nicht auf TCP 80.\" (Die Anwendung läuft auf Port 80.)\n\n**Finden mit:** *Operations > Visibility & Troubleshooting* (web1 → app1, TCP 80), danach `show zoning-rule` auf leaf101."
  },
  {
   "title": "Ticket 4",
   "text": "„app1 kann nicht einmal sein Gateway 10.20.20.1 pingen.\"\n\n**Finden mit:** Traffic-Test app1 → 10.20.20.1 und `show ip route vrf Ops:Ops` auf leaf102."
  },
  {
   "title": "Ticket 5",
   "text": "„backup1 wird in der Fabric nicht gelernt.\"\n\n**Finden mit:** Tab *Faults* der EPG **Backup** und `show endpoint` auf leaf101.",
   "hint": "Schau dir die Bridge-Domain-Zuordnung der EPG Backup genau an."
  },
  {
   "title": "Ticket 6",
   "text": "„Seit dem Fix für Ticket 3 kommt die Anfrage an, aber keine Antwort zurück.\"\n\n**Finden mit:** Traffic-Test web1 → app1 TCP 80: Er zeigt Anfrage und Antwort getrennt.",
   "hint": "Was regelt die Option *Reverse Filter Ports* am Subject?"
  }
 ],
