 "questions": [
  {
   "id": "q1",
   "q": "Was ist der Unterschied zwischen Intra EPG Isolation und einem Intra-EPG Contract?",
   "options": [
    "Isolation verbietet allen Verkehr innerhalb der EPG, der Contract erlaubt gezielt einzelne Dienste",
    "Beides ist dasselbe",
    "Isolation gilt nur für ICMP",
    "Der Contract gilt nur zwischen verschiedenen EPGs"
   ],
   "answer": 0,
   "explain": "Isolation ist ein Ein/Aus-Schalter. Der Intra-EPG Contract macht die EPG zur Whitelist für Verkehr innerhalb der Gruppe."
  },
  {
   "id": "q2",
   "q": "Warum nicht einfach jeden Webserver in eine eigene EPG legen?",
   "options": [
    "Das geht technisch nicht",
    "Die Gruppe hat dieselbe Rolle und dieselben Freigaben nach außen – getrennte EPGs verdoppeln Contracts und Pflege",
    "EPGs dürfen nur einen Endpoint haben",
    "Weil dann das VLAN fehlt"
   ],
   "answer": 1,
   "explain": "Die EPG beschreibt die Rolle. Intra-EPG-Regeln begrenzen die Gruppe intern, ohne das Rollenmodell aufzubrechen."
  }
 ],
