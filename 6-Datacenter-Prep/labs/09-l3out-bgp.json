 "questions": [
  {
   "id": "q1",
   "q": "Die Session bleibt in „Active“. Der Router meldet „bad remote AS 65000“. Was ist falsch?",
   "options": [
    "Die Fabric-AS (eigene AS der ACI) passt nicht zu dem, was der Provider erwartet",
    "Das VLAN",
    "Der Contract",
    "Die Router ID"
   ],
   "answer": 0,
   "explain": "Der Provider prüft die AS, die die ACI im OPEN meldet – das ist die Fabric-AS."
  },
  {
   "id": "q2",
   "q": "Warum braucht das Sub-Interface ein VLAN aus dem Pool der L3 Domain?",
   "options": [
    "Das Encap des Sub-Interfaces wird wie jedes Encap gegen die Domain des L3Outs geprüft",
    "Braucht es nicht",
    "Weil BGP VLANs zählt",
    "Wegen des Contracts"
   ],
   "answer": 0,
   "explain": "Fehlt VLAN 301 im Pool, gibt es einen Fault am L3Out und das Interface kommt nicht hoch."
  }
 ],
