 "questions": [
  {
   "id": "q1",
   "q": "Was sagt „encap-already-in-use: Encap (vlan-120) is already in use by Shop:Webshop:App“?",
   "options": [
    "Auf diesem Leaf gehört vlan-120 schon der EPG App; eine zweite EPG kann es dort nicht nutzen",
    "vlan-120 fehlt im VLAN Pool",
    "Die EPG hat keine Domain",
    "Der Port ist in einem Port-Channel"
   ],
   "answer": 0,
   "explain": "Das ist die dritte Ursache von F0467. invalid-vlan (Pool/Domain) und invalid-path (Access-Kette) sind die beiden anderen."
  },
  {
   "id": "q2",
   "q": "Welche Abhilfe nennt der TechNote zusätzlich, wenn beide EPGs wirklich dasselbe VLAN brauchen?",
   "options": [
    "Per-Port VLAN (VLAN-Scope Port Local) oder einen anderen Leaf/vPC nutzen",
    "Den Contract löschen",
    "Die Bridge Domain tauschen",
    "Unicast Routing ausschalten"
   ],
   "answer": 0,
   "explain": "Mit Port-Local-Scope kann dasselbe VLAN auf verschiedenen Ports eines Leafs zu verschiedenen EPGs gehören. Im Simulator ist das nicht modelliert."
  }
 ],
