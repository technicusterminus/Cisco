 "questions": [
  {
   "id": "q1",
   "q": "Warum braucht der Port zum APIC eine Access Policy, obwohl der APIC kein Server ist?",
   "options": [
    "Das In-Band-VLAN wird wie jedes andere VLAN auf einem Access-Port gegen Domain und Pool geprüft",
    "Braucht er nicht",
    "Wegen LLDP",
    "Wegen der Discovery"
   ],
   "answer": 0,
   "explain": "Ohne die Kette darf vlan-90 nicht auf eth1/48 – Fault S0211 am In-Band EPG."
  },
  {
   "id": "q2",
   "q": "Was ist der Vorteil von In-Band gegenüber OOB, was der Nachteil?",
   "options": [
    "In-Band braucht kein eigenes Management-Netz, hängt aber an der Fabric – fällt sie aus, ist auch das Management weg",
    "In-Band ist immer sicherer",
    "OOB geht nur mit RADIUS",
    "Kein Unterschied"
   ],
   "answer": 0,
   "explain": "Deshalb betreiben viele beides: OOB als Rückfallweg."
  }
 ],
