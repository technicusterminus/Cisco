 "tasks": [
  {
   "title": "Access Policies für die APIC-Ports",
   "text": "Der APIC hängt an **leaf101/102 eth1/48**. VLAN Pool **VLAN-Pool-INB** (static, vlan-90), Physical Domain **PhysDom-INB**, AAEP **AAEP-APIC**, Policy Group **IPG-APIC** und im Interface Profile IntProf-Leaf101-102 einen Selector **APIC-Ports** für Port 1/48.",
   "hint": "Ohne diese Kette darf vlan-90 nicht auf den Port zum APIC – Fault S0211 am In-Band EPG."
  },
  {
   "title": "BD inb",
   "text": "Im Tenant **mgmt** am BD **inb** das Subnetz **10.90.0.1/24** anlegen."
  },
  {
   "title": "In-Band EPG",
   "text": "**Tenants > mgmt > Node Management EPGs**: Rechtsklick **Create In-Band Management EPG**: **default**, vlan-90, BD inb, Adressen für Node 1 (APIC), 101 und 102."
  },
  {
   "title": "RADIUS über In-Band",
   "text": "RADIUS Provider 192.168.20.41 mit Key Rad#2026 und Management EPG **In-Band (default)**, Provider Group **RAD**, Login Domain **RAD** (Realm RADIUS)."
  },
  {
   "title": "Verifizieren",
   "text": "Operational-Tab des In-Band EPG, `show controller`, auf leaf101 `show vlan extended`. Login als `opsuser` mit Domain RAD."
  }
 ],
 "checks": [
  {
   "desc": "In-Band aktiv auf apic1, leaf101 und leaf102",
   "type": "inb",
   "nodes": [
    1,
    101,
    102
   ]
  },
  {
   "desc": "Kein S0211-Fault mehr",
