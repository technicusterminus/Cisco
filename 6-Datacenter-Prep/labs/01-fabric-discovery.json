 "questions": [
  {
   "id": "q1",
   "q": "Warum erscheinen die Spines erst, nachdem leaf101 aktiv ist?",
   "options": [
    "Der APIC sieht nur direkte LLDP-Nachbarn aktiver Switches; die Spines hängen an den Leafs, nicht am APIC",
    "Spines werden immer zuletzt registriert, egal wie verkabelt",
    "Weil die Spines ein anderes Image brauchen",
    "Weil die Route Reflector Policy fehlt"
   ],
   "answer": 0,
   "explain": "Discovery folgt der Verkabelung: APIC → Leaf → Spine → übrige Leafs."
  },
  {
   "id": "q2",
   "q": "Nach der Registrierung: Auf welchen Leafs ist die VRF Shop:Prod deployed?",
   "options": [
    "Auf leaf101 und leaf102 – dort hängen Endpoints ihrer EPGs",
    "Auf allen vier Leafs",
    "Nur auf den Spines",
    "Nur auf dem APIC"
   ],
   "answer": 0,
   "explain": "Die ACI deployed VRF, BD und EPG nur dort, wo sie gebraucht werden (`show vrf` auf leaf103 zeigt sie nicht)."
  },
  {
   "id": "q3",
   "q": "Was ist physisch, was logisch?",
