 "id": "21-aaa-tacacs-rbac",
 "title": "21 AAA: TACACS+, Login-Domain und RBAC",
 "topic": "Security",
 "level": "Fortgeschritten",
 "duration": "35 min",
 "fabric": "discovered",
 "kind": "requirements",
 "modes": [
  "guided",
  "exam"
