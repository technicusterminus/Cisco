 "questions": [
  {
   "id": "q1",
   "q": "Was stellt ein Config Rollback wieder her?",
   "options": [
    "Nur die Konfiguration – gelernte Endpoints und die Außenwelt bleiben",
    "Alles inklusive der Server",
    "Nur den letzten Befehl",
    "Nur die Contracts"
   ],
   "answer": 0,
   "explain": "Der Rollback spielt den Konfigurationsstand des Snapshots ein; der operative Zustand wird daraus neu berechnet."
  },
  {
   "id": "q2",
   "q": "Warum den Snapshot vor dem Change und nicht danach?",
   "options": [
    "Danach enthält er schon den Fehler",
    "Weil der APIC danach keine Snapshots mehr erlaubt",
    "Das ist egal",
    "Wegen der Lizenz"
   ],
   "answer": 0,
   "explain": "Der Sicherungspunkt muss den letzten guten Stand zeigen."
  }
 ],
