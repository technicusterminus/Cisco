 "tasks": [
  {
   "title": "Analyse",
   "text": "Faults ansehen (S2534 am BD), Traffic-Test web1 → app1, auf leaf101 `show mcp internal info interface all`. Simulation > Legacy-Switches zeigt die Schleife."
  },
  {
   "title": "MCP aktivieren",
   "text": "**Fabric > Access Policies > Policies > Global > MCP Instance Policy default**: Admin State enabled, Key `Mcp#Fabric2026`, Loop Protection Action Port Disable.",
   "hint": "Ohne *Enable MCP PDU per VLAN* sendet MCP nur untagged – die Schleife in vlan-110 bleibt unentdeckt."
  },
  {
   "title": "PDU per VLAN",
   "text": "In derselben Policy **Enable MCP PDU per VLAN** aktivieren. Jetzt error-disabled MCP einen der Ports (`show interface status err-disabled`)."
  },
  {
   "title": "Endpoint Loop Protection",
   "text": "**System Settings > Endpoint Controls**: Ep Loop Protection aktivieren (Action Port Disable) – als Absicherung, falls MCP auf einem Port fehlt."
  },
  {
   "title": "QoS",
   "text": "EPG **App**: QoS Class **Level2**. Auf einem Leaf `show qos classes`."
  }
 ],
 "checks": [
  {
   "desc": "Schleife durch MCP gebrochen",
   "type": "loop",
   "switch": "cat-lager",
