 "requirements": [
  "Die Schleife über cat-lager wird von der Fabric selbst erkannt und gebrochen; der Webshop läuft wieder.",
  "Künftige Schleifen schaltet die Fabric automatisch ab, auch pro VLAN, abgesichert mit einem Schlüssel.",
  "Springende Endpoints werden zusätzlich erkannt.",
  "Die EPG App bekommt die QoS-Klasse Level2."
 ],
 "limits": [
  "Der Legacy-Switch wird als Brücke zwischen seinen Ports simuliert; Spanning Tree des Catalyst ist nicht modelliert."
 ],
 "hints": [
  "**Konzept:** Die ACI leitet keine STP-BPDUs aus, sie flutet sie nur. Gegen Schleifen über fremde Switches hilft MCP: Die Fabric schickt eigene Pakete und schaltet einen Port ab, über den sie sie zurückbekommt.",
  "**Objekte:** *Fabric > Access Policies > Policies > Global*: MCP Instance Policy (Admin State, Key, PDU per VLAN, Aktion). Für springende Endpoints: *System > System Settings > Endpoint Controls* – Rogue EP Control (laut Cisco ab APIC 3.2 empfohlen) oder Ep Loop Protection. An der EPG App die QoS Class.",
  "**Prüfschritte:** `show mcp internal info interface all` auf leaf101/102, `show interface status err-disabled`. EP Tracker web1: springt die MAC?",
  "**Lösung:** MCP Instance Policy default: enabled, Key gesetzt, PDU per VLAN, Port Disable. Endpoint Loop Protection enabled. EPG App QoS Level2."
 ],
 "cause": "MCP ist global aus; die Schleife über cat-lager flutet den BD-Web.",
 "tasks": [],
 "checks": [
  {
   "desc": "Schleife von der Fabric gebrochen",
   "type": "loop",
   "switch": "cat-lager",
   "action": "mcp"
  },
  {
   "desc": "Schleifenerkennung pro VLAN aktiv",
   "type": "exists",
   "dn": "uni/infra/mcpInstP-default",
   "attrs": {
    "adminSt": "enabled",
    "ctrl": "pdu-per-vlan"
   },
   "category": "security"
  },
  {
   "desc": "Springende Endpoints werden erkannt",
   "type": "exists",
   "dn": "uni/infra/epCtrlP-default",
   "attrs": {
    "adminSt": "enabled"
   },
   "any": [
    {
     "dn": "uni/infra/epCtrlP-default",
     "attrs": {
      "adminSt": "enabled"
     }
    },
    {
     "dn": "uni/infra/epLoopProtectP-default",
     "attrs": {
      "adminSt": "enabled"
     }
    }
   ]
  },
  {
   "desc": "web1 → app1 tcp/8080 wieder erreichbar",
   "type": "traffic",
   "src": "web1",
   "dst": "app1",
   "proto": "tcp",
   "port": 8080,
   "expect": true
  },
  {
   "desc": "EPG App in QoS-Klasse Level2",
   "type": "exists",
   "dn": "uni/tn-Shop/ap-Webshop/epg-App",
   "attrs": {
    "prio": "level2"
   }
  },
  {
   "desc": "Schleifen-Ports werden abgeschaltet",
   "type": "class",
   "cls": "mcpInstPol",
   "under": "uni/infra/mcpInstP-default",
   "attrs": {
    "loopProtectAct": "port-disable"
   },
   "category": "security"
  }
 ],
 "questions": [
  {
   "id": "q1",
   "q": "Warum erkennt die ACI die Schleife nicht über Spanning Tree?",
   "options": [
    "Die ACI nimmt nicht an STP teil, sie flutet BPDUs nur im EPG/VLAN",
    "Weil der Catalyst kein STP kann",
    "Weil MCP STP ersetzt",
    "Sie erkennt sie über STP"
   ],
   "answer": 0,
   "explain": "Deshalb braucht es MCP (und ggf. die BPDUs des Fremdswitches, die über die Fabric laufen)."
  }
 ],
 "solution": "`uni/infra/mcpInstP-default`: `{\"mcpInstPol\": {\"attributes\": {\"adminSt\": \"enabled\", \"key\": \"Mcp#Fabric2026\", \"ctrl\": \"pdu-per-vlan\", \"loopProtectAct\": \"port-disable\"}}}`, `uni/infra/epLoopProtectP-default` adminSt=enabled (gleichwertig und laut Cisco empfohlen: `uni/infra/epCtrlP-default` adminSt=enabled, Rogue EP Control), EPG App prio=level2.",
 "routers": [],
 "vcenters": [],
 "devices": [],
