 "tasks": [
  {
   "title": "vPC-Domäne",
   "text": "**Fabric > Access Policies > Policies > Switch > Virtual Port Channel default**: Explicit vPC Protection Group **vpc-103-104**, ID **34**, Switches 103 und 104."
  },
  {
   "title": "Port Channel Policy",
   "text": "**Policies > Interface > Port Channel**: **LACP-Active** mit Mode *LACP Active*."
  },
  {
   "title": "vPC Policy Group",
   "text": "**Policy Groups > PC/VPC Interface**: **IPG-vPC-db1**, Typ *Virtual Port Channel*, AAEP **AAEP-Server**, Port Channel Policy LACP-Active."
  },
  {
   "title": "Interface- und Switch-Profil",
   "text": "Interface Profile **IntProf-Leaf103-104** mit Selector **db1** für Port 1/10 → IPG-vPC-db1. Switch Profile **SwProf-Leaf103-104** für die Nodes 103-104."
  },
  {
   "title": "Tenant",
   "text": "Im Tenant Shop: **BD-DB** mit **10.10.30.1/24** im VRF Prod, EPG **DB** im AP Webshop mit Domain PhysDom-Server und Static Port **Virtual Port Channel** IPG-vPC-db1, **vlan-130**.",
   "hint": "Den vPC-Pfad gibt es erst, wenn die vPC Policy Group auf Ports beider Leafs angewendet ist."
  },
  {
   "title": "Contract",
   "text": "Filter **mysql** (tcp/3306), Contract **app-to-db**: DB provided, App consumed."
  },
  {
   "title": "Prüfen",
   "text": "Auf leaf103: `show vpc brief` und `show port-channel summary`. Was passiert, wenn du die Port Channel Policy auf *Static Channel - Mode On* stellst?"
  }
 ],
