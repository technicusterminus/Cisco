 "questions": [
  {
   "id": "q1",
   "q": "Die Port Channel Policy steht auf „Static Channel - Mode On“, der Server sendet LACP. Was passiert?",
   "options": [
    "Der Server bekommt keine LACP-Antwort, suspendiert seine Links und db1 wird nicht gelernt",
    "Es funktioniert genauso",
    "Nur ein Link wird genutzt",
    "Der APIC meldet einen Fault an der EPG"
   ],
   "answer": 0,
   "explain": "Mode On sendet keine LACP-PDUs. Ein LACP-Server nimmt die Links dann nicht ins Bundle."
  },
  {
   "id": "q2",
   "q": "Warum reicht je ein Static Port auf leaf103 eth1/10 und leaf104 eth1/10 nicht?",
   "options": [
    "Zwei Einzelports sind zwei Pfade – der Bond des Servers braucht einen gemeinsamen vPC-Pfad",
    "Weil Static Ports nur auf einem Leaf gehen",
    "Das reicht",
    "Weil VLAN 130 fehlt"
   ],
   "answer": 0,
   "explain": "Der Server sieht zwei Links zu „einem“ Partner. Das bildet in der ACI erst der vPC ab."
  }
 ],
