 "tasks": [
  {
   "title": "Remote Location",
   "text": "**Admin > Import/Export > Remote Locations**: **SCP-Backup**, Host 192.168.10.50, SCP, Port 22, Pfad /backup, Benutzer backup, Management EPG **default (Out-of-Band)**."
  },
  {
   "title": "Import",
   "text": "**Import Policies > Configuration**: **Restore-Shop**, Datei aus dem Backup, Import Type **Merge**, Mode **Atomic**, Remote Location SCP-Backup, *Start Now: Triggered*. Ergebnis unter **Jobs**.",
   "hint": "Replace würde alles, was nicht im Backup steht, im Zielbereich ersetzen – für einen einzelnen Tenant ist Merge der sichere Weg."
  },
  {
   "title": "Prüfen",
   "text": "web1 und app1 sind wieder gelernt, web1 → app1 tcp/8080 klappt."
  },
  {
   "title": "AES-Verschlüsselung",
   "text": "**System Settings > Global AES Passphrase Encryption Settings** (oder Import/Export > Global AES Encryption): Encryption einschalten, Passphrase z. B. `Nightly-Backup#2026`."
  },
  {
   "title": "Export",
   "text": "**Export Policies > Configuration**: **Fabric-Nightly**, Remote Location SCP-Backup, Include Secure Fields yes, sofort starten. Unter Simulation > Fileserver & Monitoring siehst du die Datei – jetzt *mit* Secure Properties."
  }
 ],
