 "solution": "NDO: onboard (Site ID 1), Infra `{\"area\": \"0.0.0.0\", \"ucastTep\": \"172.16.100.1/32\", \"peering\": \"full-mesh\", \"spines\": [{\"node\": 201, \"port\": \"eth1/31\", \"ip\": \"10.255.1.1/30\", \"evpnRid\": \"10.255.255.201\"}, {\"node\": 202, \"port\": \"eth1/31\", \"ip\": \"10.255.1.5/30\", \"evpnRid\": \"10.255.255.202\"}]}`, Deploy Infra; ISN-MTU auf 9150; Templates `{\"name\": \"Shop-Stretched\", \"tenant\": \"Shop\", \"sites\": [\"local\", \"DC-HAM\"], \"vrfs\": [\"Prod\"], \"bds\": [{\"name\": \"BD-Web\", \"vrf\": \"Prod\", \"subnet\": \"10.10.10.1/24\", \"l2stretch\": true, \"bum\": false}], \"aps\": [{\"name\": \"Webshop\", \"epgs\": [{\"name\": \"Web\", \"bd\": \"BD-Web\", \"cons\": [\"web-to-ham\"], \"prov\": []}]}], \"contracts\": [{\"name\": \"web-to-ham\", \"filter\": \"tcp/8080,icmp\"}]}` und `{\"name\": \"HAM-Local\", \"tenant\": \"Shop\", \"sites\": [\"DC-HAM\"], \"vrfs\": [], \"bds\": [{\"name\": \"BD-HAM-App\", \"vrf\": \"Prod\", \"subnet\": \"10.20.20.1/24\", \"l2stretch\": false, \"bum\": false}], \"aps\": [{\"name\": \"Webshop\", \"epgs\": [{\"name\": \"App-HAM\", \"bd\": \"BD-HAM-App\", \"cons\": [], \"prov\": [\"web-to-ham\"]}]}], \"contracts\": []}` deployen.",
 "routers": [],
 "vcenters": [],
 "devices": [],
 "aaa": [],
 "switches": [],
