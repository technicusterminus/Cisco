 "questions": [
  {
   "id": "q1",
   "q": "Warum zeigt der Traffic Inspector bei Ticket 1 keine Policy-Entscheidung?",
   "options": [
    "Weil app1 nicht gelernt ist – ohne Endpoint keine EPG und damit kein Contract-Lookup",
    "Weil der Contract fehlt",
    "Weil die Policy auf dem Spine geprüft wird",
    "Weil ICMP nicht erlaubt ist"
   ],
   "answer": 0,
   "explain": "Die Policy (Zoning Rules) gilt zwischen EPGs. Ein Paket eines ungelernten Hosts wird gar nicht klassifiziert – darum zuerst die Access-Kette."
  },
  {
   "id": "q2",
   "q": "web2: Static Port vlan-111, der Server sendet VLAN 110. Gibt es einen Fault?",
   "options": [
    "Nein – die Konfiguration ist gültig, sie passt nur nicht zum Server",
    "Ja, F0467 invalid-vlan",
    "Ja, ein Fault am Leaf-Port",
    "Ja, weil VLAN 111 nicht im Pool ist"
   ],
   "answer": 0,
   "explain": "vlan-111 liegt im Pool, das Deployment klappt. Der APIC weiß nicht, was der Server sendet; den Widerspruch sieht man erst am fehlenden Endpoint."
  },
  {
   "id": "q3",
   "q": "Warum ist ein Static Leaf (EPG auf dem ganzen leaf101) für web-Server hier falsch?",
   "options": [
    "Er deployed die EPG auf allen Ports des Leafs mit passender Domain – auch auf eth1/9 mit dem fremden Gerät",
    "Static Leaf gibt es nicht",
    "Er ist gleichwertig zum Static Port",
    "Er funktioniert nur mit vPC"
   ],
   "answer": 0,
   "explain": "Least Privilege gilt auch im Access-Teil: EPGs nur dort deployen, wo ihre Server hängen."
  }
 ],
