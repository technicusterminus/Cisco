 "questions": [
  {
   "id": "q1",
   "q": "Warum landet der Traffic an die VIP beim Standby?",
   "options": [
    "Der Leaf hat die VIP aus einem Datenpaket des Standby (TCP RST) gelernt",
    "Der Contract erlaubt nur den Standby",
    "Der Standby hat ein anderes VLAN",
    "ARP Flooding ist aus"
   ],
   "answer": 0,
   "explain": "Mit IP Data-plane Learning aktualisiert jedes Paket die IP-zu-Port-Bindung. Der GARP des Active wird vom späteren RST des Standby überschrieben."
  },
  {
   "id": "q2",
   "q": "Was lernt ein Leaf, wenn IP Data-plane Learning aus ist?",
   "options": [
    "Lokale MACs weiter per Data Plane, lokale IPs nur per ARP/GARP/ND",
    "Gar keine Endpoints mehr",
    "Nur Remote-Endpoints",
    "Nur IPs, keine MACs"
   ],
   "answer": 0,
   "explain": "So steht es im White Paper (Table 2): MACs weiter per Data Plane, lokale IPs über die Control Plane, Remote-IPs nicht aus Unicast-Paketen."
  }
 ],
 "solution": "`POST /api/mo/uni/tn-Shop/ctx-Prod.json` mit `{\"fvCtx\": {\"attributes\": {\"ipDataPlaneLearning\": \"disabled\"}}}`",
