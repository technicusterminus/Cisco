 "questions": [
  {
   "id": "q1",
   "q": "Warum reicht es nicht, den Port von web-inf einfach abzuschalten?",
   "options": [
    "Dann ist der Host für die Forensik weg; die uSeg EPG isoliert ihn, ohne ihn vom Netz zu nehmen",
    "Abschalten geht in der ACI nicht",
    "Weil dann auch web1 ausfällt",
    "Das reicht"
   ],
   "answer": 0,
   "explain": "Die Anforderung verlangt, dass web-inf gelernt bleibt – also isolieren statt trennen."
  },
  {
   "id": "q2",
   "q": "Ein Contract zwischen der EPG Web und der ESG Backend – geht das?",
   "options": [
    "Nein, Contracts gibt es nur zwischen ESGs oder nur zwischen EPGs",
    "Ja, wenn der Scope global ist",
    "Ja, immer",
    "Nur mit vzAny"
