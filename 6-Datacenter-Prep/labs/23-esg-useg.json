 "tasks": [
  {
   "title": "Static Port für web-inf",
   "text": "An der EPG **Web** einen Static Port leaf101 eth1/3, vlan-110 ergänzen. web-inf ist dann in Web gelernt."
  },
  {
   "title": "uSeg EPG",
   "text": "Im AP Webshop unter **uSeg EPGs** die EPG **Quarantine** (BD-Web, Domain PhysDom-Server) mit dem IP-Attribut **10.10.10.66** anlegen.",
   "hint": "Die ACI klassifiziert den Host jetzt nach seiner IP in Quarantine – Port und VLAN bleiben gleich."
  },
  {
   "title": "Filter und Contract",
   "text": "Filter **tcp-8080** und Contract **frontend-to-backend**."
  },
  {
   "title": "ESGs",
   "text": "**Endpoint Security Groups**: **Frontend** (VRF Prod, EPG Selector Web) konsumiert, **Backend** (VRF Prod, EPG Selector App) stellt den Contract bereit.",
   "hint": "Ein Contract zwischen einer ESG und einer EPG ist nicht möglich."
  },
  {
   "title": "Prüfen",
   "text": "web1 → app1 tcp/8080 klappt, web-inf → app1 nicht. Im Traffic-Test siehst du die Klassifizierung (EPG → ESG). Auf leaf101: `show zoning-rule` – welche pcTags stehen in den Regeln?"
  }
 ],
 "checks": [
  {
   "desc": "web-inf liegt in der uSeg EPG Quarantine",
   "type": "endpoint",
   "host": "web-inf",
   "epg": "uni/tn-Shop/ap-Webshop/epg-Quarantine"
  },
  {
   "desc": "web1 → app1 tcp/8080 über die ESGs",
   "type": "traffic",
   "src": "web1",
   "dst": "app1",
   "proto": "tcp",
   "port": 8080,
   "expect": true,
   "via": "ESG"
  },
