 "tasks": [
  {
   "title": "Tenant und VRF",
   "text": "Tenant **Shop**, darin VRF **Prod** (Policy Enforcement: Enforced)."
  },
  {
   "title": "Bridge Domains",
   "text": "**BD-Web** mit Gateway **10.10.10.1/24** und **BD-App** mit **10.10.20.1/24**, beide im VRF Prod."
  },
  {
   "title": "Application Profile und EPGs",
   "text": "AP **Webshop** mit den EPGs **Web** (BD-Web) und **App** (BD-App). Beide bekommen die Physical Domain **PhysDom-Server**."
  },
  {
   "title": "Static Ports",
   "text": "Web: leaf101 eth1/1, **vlan-110**, Trunk. App: leaf102 eth1/2, **vlan-120**, Trunk."
  },
  {
   "title": "Testen",
   "text": "web1 kann sein Gateway 10.10.10.1 pingen. Ein Ping von web1 zu app1 scheitert – warum? Schau dir auf leaf101 `show zoning-rule` an."
  }
 ],
 "checks": [
