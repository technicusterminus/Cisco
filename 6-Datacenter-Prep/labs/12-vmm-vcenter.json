   ],
   "category": "security"
  },
  {
   "desc": "app-vm1 baut außer Ping keine Verbindungen zu web-vm1 auf",
   "type": "exposure",
   "src": "app-vm1",
   "dst": "web-vm1",
   "allow": [
    "icmp"
   ],
   "category": "security"
  }
 ],
 "questions": [
  {
   "id": "q1",
   "q": "Warum braucht die VMM Domain einen VLAN Pool mit Dynamic Allocation?",
   "options": [
    "Der APIC wählt die VLANs für die Port Groups selbst aus dem Bereich",
    "Weil vCenter keine statischen VLANs kennt",
    "Weil sonst LLDP nicht geht",
    "Braucht sie nicht"
   ],
   "answer": 0,
   "explain": "Bei Static Allocation müsste jemand das VLAN pro EPG festlegen – das ist nicht der VMM-Weg."
  },
  {
   "id": "q2",
   "q": "Resolution Immediacy „On Demand“: Wann kommt das VLAN auf leaf102?",
   "options": [
    "Erst wenn eine VM der EPG auf einem Host an leaf102 läuft",
    "Sofort beim Speichern",
    "Nie",
    "Nach einem Neustart"
   ],
   "answer": 0,
   "explain": "On Demand spart Ressourcen auf den Leafs, macht die Fehlersuche aber weniger offensichtlich."
  }
 ],
