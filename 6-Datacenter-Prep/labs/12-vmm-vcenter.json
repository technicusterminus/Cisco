 "tasks": [
  {
   "title": "Dynamischer VLAN Pool",
   "text": "**Fabric > Access Policies > Pools > VLAN**: **VLAN-Pool-VMM** mit *Dynamic Allocation* und dem Encap Block vlan-1000 bis vlan-1099.",
   "hint": "Ein statischer Pool reicht nicht: Der APIC vergibt die VLANs für die Port Groups selbst."
  },
  {
   "title": "VMM Domain",
   "text": "**Virtual Networking > VMM Domains > VMware**, Rechtsklick **Create vCenter Domain**: Name **VDS-Prod**, VLAN Pool VLAN-Pool-VMM, AAEP **AAEP-ESXi**, Credential **vc-admin** und Controller **vcsa01** mit IP und Datacenter.",
   "hint": "Der Datacenter-Name muss exakt stimmen. Unter **Operational** der Domain siehst du, ob der APIC verbunden ist (Fault S0606, wenn nicht)."
  },
  {
   "title": "EPGs anbinden",
   "text": "An den EPGs **Web** und **App** jeweils **Add VMM Domain Association** mit VDS-Prod, Resolution Immediacy **Immediate**."
  },
  {
   "title": "Prüfen",
   "text": "Unter **Simulation > vCenter** erscheinen die Port Groups mit VLANs aus dem Pool, die VMs werden gelernt. Auf leaf101: `show vlan extended` und `show endpoint` – Learning Source *learned,vmm*."
  },
  {
   "title": "Experiment",
   "text": "Stelle die Resolution Immediacy an der EPG App auf **On Demand** und lösche app-vm1. Was passiert mit dem VLAN auf leaf102?"
  }
 ],
 "checks": [
  {
   "desc": "VMM Domain VDS-Prod mit vCenter verbunden",
   "type": "vmm",
   "dn": "uni/vmmp-VMware/dom-VDS-Prod"
  },
  {
   "desc": "web-vm1 in EPG Web gelernt",
   "type": "endpoint",
   "host": "web-vm1",
   "epg": "uni/tn-Shop/ap-Webshop/epg-Web"
  },
